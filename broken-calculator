class Solution {
    public int brokenCalc(int startValue, int target) {
        Queue<Integer> qu = new LinkedList<>();
        HashSet<Integer> set = new HashSet<>();
        qu.add(startValue);
        int count = 0;
        while (!qu.isEmpty()) {
            int size = qu.size();
            for (int i = 0; i < size; i++) {
                int polled = qu.poll();
                if (polled == target)  return count;
                
                if (polled < target) { 
                    int multi = polled * 2;
                    if (!set.contains(multi)) {//checking weather its visited or not
                        qu.add(multi);
                    }
                }
                if (target > 0) {
                    int sub = polled - 1;
                    if (!set.contains(sub)) {//checking weather its visited or not
                        qu.add(sub);
                    }

                }

            }
            count++;
        }
        return 0;
    }
}




